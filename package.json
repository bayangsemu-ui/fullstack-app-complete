{
  "name": "fullstack-app-complete",
  "version": "1.0.0",
  "description": "Complete Full-Stack Application - React + Node.js + PostgreSQL",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspaces",
    "setup": "node scripts/setup.js",
    "setup:db": "node scripts/setup-db.js",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "install:all": "npm install && npm install --workspace=server && npm install --workspace=client"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
